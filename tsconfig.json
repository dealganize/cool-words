{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["google-apps-script"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
